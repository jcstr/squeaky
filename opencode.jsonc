{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "*sudo *", "effect": "deny" },
    { "action": "shell", "resource": "squeaky clean*", "effect": "deny" },
    { "action": "shell", "resource": "*squeaky clean*", "effect": "deny" }
  ]
}
